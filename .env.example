# ---------------------------------------------------------------------------
# SECRETS — never commit this file (.gitignore already excludes it)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=changeme

# --- LLM provider order: NVIDIA -> OpenRouter -> Cline -----------------------
# NVIDIA is tried first (not rate-capped like OpenRouter's free tier). If it
# times out / errors, OpenRouter is tried next. If OpenRouter's budget/rate
# limit is exhausted, Cline's free models absorb the overflow.
NVIDIA_API_KEY=changeme
# Comma-separated override; leave blank to use the verified defaults in jobhunter/llm/nvidia.py
NVIDIA_MODELS=
NVIDIA_DAILY_CAP=300

CLINE_API_KEY=changeme
# Comma-separated override; leave blank to use the verified defaults in jobhunter/llm/cline.py
CLINE_MODELS=
CLINE_DAILY_CAP=100

SITE_URL=changeme
SITE_NAME=changeme

# --- daily automation ---
JOBHUNTER_TZ=changeme
JOBHUNTER_RUN_HOUR=changeme
JOBHUNTER_RUN_MINUTE=changeme
JOBHUNTER_DEEP_N=changeme
JOBHUNTER_RESUMES=changeme
JOBHUNTER_MIN_SCORE=changeme

# --- API budget guardrails (see config/models.json for the full policy) ---
# Leave blank to auto-detect the real limits from GET /api/v1/key
JOBHUNTER_MAX_LLM_CALLS_PER_DAY=
JOBHUNTER_MAX_LLM_CALLS_PER_RUN=changeme
