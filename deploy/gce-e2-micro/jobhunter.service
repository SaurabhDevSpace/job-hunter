[Unit]
Description=Job Hunter Dashboard
After=network.target

[Service]
Type=simple
User=jobhunter
WorkingDirectory=/opt/jobhunter
EnvironmentFile=/opt/jobhunter/.env
ExecStart=/opt/jobhunter/.venv/bin/python -m jobhunter.cli serve --host 127.0.0.1 --port 8080
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
